

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign class = 'add-to-cart-button ' | append: block.settings.style_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
  assign buy_now_class = 'add-to-cart-button add-to-cart-button--buy-now button-secondary'
  assign buy_now_id = 'BuyButtons-ProductBuyNowButton-' | append: block.id
%}

<span
  class="add-to-cart-block"
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% render 'add-to-cart-button',
    id: buy_now_id,
    class: buy_now_class,
    can_add_to_cart: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: 'Buy it Now',
    data_testid: 'standalone-buy-it-now',
    buy_now: true,
    icon_svg: block.settings.buy_now_icon_svg
  %}

  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{% stylesheet %}
  .add-to-cart-block {
    display: grid;
    gap: 0.85rem;
    width: 100%;
  }

  .add-to-cart-block .add-to-cart-button--buy-now {
    --button-color: #ffffff;
    --button-background-color: #9ca9c8;
    --button-border-color: transparent;
    --button-border-width: 0;
    width: 100%;
    min-height: 3.5rem;
    padding-block: 1rem;
    padding-inline: 1.4rem;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgb(156 169 200 / 0.28);
    font-size: 1rem;
    font-weight: 600;
  }

  .add-to-cart-block .add-to-cart-button--buy-now:hover:not([disabled]) {
    --button-color: #ffffff;
    --button-background-color: #8f9dbc;
    --button-border-color: transparent;
  }

  .add-to-cart-block .add-to-cart-button--buy-now .add-to-cart-text {
    gap: 0.65rem;
  }

  .add-to-cart-block .add-to-cart-button--buy-now .add-to-cart-icon {
    width: 1rem;
    height: 1rem;
  }

  .add-to-cart-block .add-to-cart__added {
    display: none;
  }

  .add-to-cart-block .add-to-cart-button[data-added='true'] .add-to-cart-text {
    clip-path: none;
    filter: none;
    opacity: 1;
    translate: 0;
    animation: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "textarea",
      "id": "buy_now_icon_svg",
      "label": "Buy it now icon SVG",
      "info": "Paste SVG markup to replace the Buy it Now button icon."
    }
  ]
}
{% endschema %}
