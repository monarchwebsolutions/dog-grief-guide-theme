<div class="section article-link-cta">
  <div
    class="section-content-wrapper spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.url != blank and section.settings.text != blank -%}
      <div class="article-link-cta__inner">
        <a
          class="article-link-cta__link"
          href="{{ section.settings.url }}"
          style="--article-link-cta-font-size: {{ section.settings.font_size }}px;"
        >
          <span>{{ section.settings.text }}</span>
          <span aria-hidden="true" class="article-link-cta__arrow">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .article-link-cta__inner {
    display: flex;
    justify-content: center;
  }

  .article-link-cta__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    font-size: var(--article-link-cta-font-size, 16px);
    font-weight: 500;
    color: var(--dgg-black);
    text-decoration: none;
  }

  .article-link-cta__link:hover {
    color: var(--dgg-blue);
  }

  .article-link-cta__arrow {
    line-height: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article Link CTA",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Learn more about The Dog Grief Guide"
    },
    {
      "type": "url",
      "id": "url",
      "label": "URL"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Article Link CTA"
    }
  ]
}
{% endschema %}
