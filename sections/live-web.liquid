<script>
const COVER_DATA_URI = 'data:image/jpeg;base64,';
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script>
// =====================================================
// DATA
// =====================================================
// kind groups dogs by breed family for the constellation effect
const stories = [
  { id: 1, dogName: "Oxmo", years: "2010 – 2024", submitter: "Nate", kind: "retriever", photo: "https://images.unsplash.com/photo-1552053831-71594a27632d?w=300&h=300&fit=crop", preview: "He was the reason this guide exists. Every page is for him.",
    story: "Oxmo was a goofy, golden, soft-souled dog who taught me what it means to love something completely. The morning he left, I started writing down everything I felt — and that became the seed of what's now in the guide.\n\nThis whole wall is for him. And for yours." },
  { id: 2, dogName: "Max", years: "2008 – 2022", submitter: "Sarah", kind: "retriever", photo: "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=300&h=300&fit=crop", preview: "He waited for me at the door for fourteen years.",
    story: "Every single day I came home, Max was at the door. Tail wagging, head tilted, like he wasn't sure I was coming back this time. The first week without him, I came home to silence and just stood there in the doorway.\n\nFourteen years he waited. I'd wait fourteen more if I could see him one more time." },
  { id: 3, dogName: "Daisy", years: "2012 – 2024", submitter: "Marcus", kind: "hound", photo: "https://images.unsplash.com/photo-1561037404-61cd46aa615b?w=300&h=300&fit=crop", preview: "She was small but she filled the whole house.",
    story: "Daisy was twelve pounds of beagle and she somehow took up every inch of every room. She had opinions. About squirrels, about the mailman, about the temperature of her water bowl. I miss her opinions." },
  { id: 4, dogName: "Bear", years: "2014 – 2023", submitter: "Hannah", kind: "working", photo: "https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?w=300&h=300&fit=crop", preview: "Gentle giant. Slept on my feet every single night.",
    story: "He weighed 110 pounds and he thought he was a lap dog. Bear would climb up onto the couch and just rest his chin on my knee while I cried, before I even knew I was about to cry. He always knew.\n\nThe quiet at night without him is the hardest part." },
  { id: 5, dogName: "Luna", years: "2011 – 2024", submitter: "Diego", kind: "spitz", photo: "https://images.unsplash.com/photo-1517849845537-4d257902454a?w=300&h=300&fit=crop", preview: "She sang to the moon. I still hear her sometimes.",
    story: "Luna was a husky and she howled at the moon every clear night. The neighbors complained for years. After she passed I stood outside on the first full moon and I swear I heard her, just for a second, somewhere on the breeze." },
  { id: 6, dogName: "Charlie", years: "2009 – 2024", submitter: "Beth", kind: "hound", photo: "https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=300&h=300&fit=crop", preview: "Fifteen good years. Not enough. Never enough.",
    story: "Charlie made it to fifteen. Doctors couldn't believe it. He was a stubborn dachshund and he wasn't going anywhere on anyone's schedule but his own. When he finally went, it was on his terms, in my arms, on a Tuesday afternoon. The bravest little soul I'll ever know." },
  { id: 7, dogName: "Sadie", years: "2013 – 2025", submitter: "Patricia", kind: "toy", photo: "https://images.unsplash.com/photo-1530281700549-e82e7bf110d6?w=300&h=300&fit=crop", preview: "She knew when I was sad before I did.",
    story: "Sadie would put her head in my lap on days I didn't even know were going to be hard yet. She'd just appear, quietly, and stay. After my divorce she didn't leave my side for weeks. Some dogs are just better humans than the rest of us." },
  { id: 8, dogName: "Cooper", years: "2015 – 2025", submitter: "James", kind: "retriever", photo: "https://images.unsplash.com/photo-1508672019048-805c876b67e2?w=300&h=300&fit=crop", preview: "My heart still listens for his collar.",
    story: "Cooper had a tag that jingled every time he walked. Three months in and I still turn my head every time I hear keys in another room. The silence where his sound used to be is its own kind of grief I wasn't ready for." },
  { id: 9, dogName: "Rosie", years: "2010 – 2023", submitter: "Tomás", kind: "bully", photo: "https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=300&h=300&fit=crop", preview: "Square head. Square shoulders. Square heart full of love.",
    story: "Rosie was a boxer and she wore her heart on her sleeve. Every emotion she had was visible from across the yard. When I came home she'd do this full-body wiggle that started at her nose and ended at her tail.\n\nI keep doing the wiggle when I see people I love now. It's the least I can do." },
  { id: 10, dogName: "Bella", years: "2012 – 2024", submitter: "Rachel", kind: "bully", photo: "https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=300&h=300&fit=crop", preview: "Big body, even bigger soul.",
    story: "People crossed the street when they saw her coming. They didn't know she was the softest soul in the neighborhood. Bella had a thing where she'd lean into me — just press her whole body against my leg — when she sensed I needed it. That lean got me through more than I'll ever admit." },
  { id: 11, dogName: "Ranger", years: "2011 – 2024", submitter: "Walt", kind: "shepherd", photo: "https://images.unsplash.com/photo-1605568427561-40dd23c2acea?w=300&h=300&fit=crop", preview: "Worked the farm with me for thirteen years.",
    story: "Ranger knew the farm better than I did. He'd be three steps ahead of every gate, every chore. The first morning I went out alone after he was gone, the cows were confused. So was I." },
  { id: 12, dogName: "Penny", years: "2014 – 2025", submitter: "Mei", kind: "toy", photo: "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=300&h=300&fit=crop", preview: "She fit perfectly under my chin.",
    story: "Eight pounds of cavalier. Penny would crawl up my chest and tuck her tiny head right under my chin every night. I have a pillow there now. It's not the same. Nothing is." },
  { id: 13, dogName: "Murphy", years: "2009 – 2023", submitter: "Liam", kind: "retriever", photo: "https://images.unsplash.com/photo-1576041897552-14ff9b4dac38?w=300&h=300&fit=crop", preview: "He lit up every single room. Even now.",
    story: "Murphy never met a stranger. The mailman cried when I told him. The vet cried. Even the lady at the dog park who didn't really like dogs cried. He had that effect on people. He had that effect on me, every single day for fourteen years." },
  { id: 14, dogName: "Stella", years: "2013 – 2024", submitter: "Jenna", kind: "bully", photo: "https://images.unsplash.com/photo-1568572933382-74d440642117?w=300&h=300&fit=crop", preview: "We rescued each other.",
    story: "I adopted Stella the week I left a relationship I shouldn't have stayed in. She was scared. I was scared. We figured it out together. She slept pressed against my back for eleven years. I learned how to be okay with her, and now I'm learning how to be okay without her." },
  { id: 15, dogName: "Henry", years: "2010 – 2022", submitter: "Carl", kind: "hound", photo: "https://images.unsplash.com/photo-1591946614720-90a587da4a36?w=300&h=300&fit=crop", preview: "Long ears. Even longer love.",
    story: "Henry was a basset hound and he had the saddest face you've ever seen on the happiest dog I've ever known. He greeted me every morning by stepping on my feet and looking up. I'd give anything to have my feet stepped on one more time." },
  { id: 16, dogName: "Willow", years: "2015 – 2025", submitter: "Anaya", kind: "shepherd", photo: "https://images.unsplash.com/photo-1535930891776-0c2dfb7fda1a?w=300&h=300&fit=crop", preview: "The smartest dog I'll ever know.",
    story: "Willow knew thirty-seven words. She could tell the difference between 'walk' and 'walked.' She knew which family member was at the door before they rang the bell. Mostly though, she knew me — when I needed to laugh, when I needed to be still, when I needed to cry into her fur. Border collies don't just love. They study you." },
  { id: 17, dogName: "Otis", years: "2011 – 2023", submitter: "Robin", kind: "bully", photo: "https://images.unsplash.com/photo-1600804340584-c7db2eacf0bf?w=300&h=300&fit=crop", preview: "Snored louder than my husband.",
    story: "Otis the bulldog had a snore you could hear in the next room. We used to joke that he and Tom were going to do a duet someday. The first nights without him the house was so quiet I couldn't sleep. I never thought I'd miss snoring." },
  { id: 18, dogName: "Goose", years: "2014 – 2024", submitter: "Eli", kind: "working", photo: "https://images.unsplash.com/photo-1574158622682-e40e69881006?w=300&h=300&fit=crop", preview: "Tall enough to rest his head on my shoulder.",
    story: "Great danes don't live long enough. Everybody knows it going in. We had ten beautiful years with Goose and it still wasn't enough. He used to walk up behind me and just rest his enormous head on my shoulder. I'd close my eyes for a second every time." },
  { id: 19, dogName: "Pepper", years: "2008 – 2024", submitter: "Margie", kind: "terrier", photo: "https://images.unsplash.com/photo-1571566882372-1598d88abd90?w=300&h=300&fit=crop", preview: "Sixteen years of stubborn love.",
    story: "Pepper was a terrier mix, eight pounds, and she ran our house. She told the bigger dogs at the park what to do. She told me what to do. She told the vet what to do. Sixteen years of being absolutely sure of herself. I'm trying to live more like she did." },
  { id: 20, dogName: "Finn", years: "2012 – 2025", submitter: "Owen", kind: "retriever", photo: "https://images.unsplash.com/photo-1601758125946-6ec2ef64daf8?w=300&h=300&fit=crop", preview: "He learned to swim before he could walk steady.",
    story: "Finn was a labradoodle who loved water more than anyone or anything. We spread some of his ashes at the lake where we'd taken him every summer. The water held him. It always did." },
  { id: 21, dogName: "Jackson", years: "2011 – 2024", submitter: "Theo", kind: "sporting", photo: "https://images.unsplash.com/photo-1551717743-49959800b1f6?w=300&h=300&fit=crop", preview: "Pointed at every squirrel until the very last day.",
    story: "Jackson was a pointer and he never stopped pointing. Even at the end, lying on the kitchen floor, he heard a squirrel outside and his head came up and his nose got serious. Some instincts don't go quiet, even when the body does." },
  { id: 22, dogName: "Harper", years: "2013 – 2024", submitter: "Sloane", kind: "sporting", photo: "https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=300&h=300&fit=crop", preview: "Velcro dog. Always touching me somewhere.",
    story: "Harper was a vizsla and she had to be touching me at all times. Foot on my leg, head on my hand, body against my back. After she passed I started keeping a heavy blanket on me at all times. It's the closest thing." },
  { id: 23, dogName: "Mabel", years: "2015 – 2024", submitter: "Joaquin", kind: "toy", photo: "https://images.unsplash.com/photo-1587402092301-725e37c70fd8?w=300&h=300&fit=crop", preview: "Three speeds: snore, snort, snuggle.",
    story: "Mabel the frenchie had a personality the size of a pickup truck packed into 22 pounds. She made the loudest noises I've ever heard from a small dog. Snoring, snorting, sneezing, the occasional drama-howl when she was hungry. The house is way too quiet now." },
  { id: 24, dogName: "Tucker", years: "2010 – 2023", submitter: "Greta", kind: "shepherd", photo: "https://images.unsplash.com/photo-1597633248230-e4c9dab1ba2f?w=300&h=300&fit=crop", preview: "He picked me at the shelter. Best decision he ever made.",
    story: "I went to the shelter to look at puppies. Tucker was three years old, gray around the muzzle already, and he just walked over and put his paw on my foot. I went home with him and he never left my side for thirteen years. He picked me. I'll never forget that." },
  { id: 25, dogName: "Juno", years: "2012 – 2025", submitter: "Wren", kind: "shepherd", photo: "https://images.unsplash.com/photo-1544568100-847a948585b9?w=300&h=300&fit=crop", preview: "She herded my kids around the yard.",
    story: "Juno was a cattle dog and she didn't have any cattle so she herded the kids. She'd circle them in the backyard until they were exactly where she wanted them. The kids are older now. They miss being herded. So do I." },
  { id: 26, dogName: "Beau", years: "2009 – 2022", submitter: "Caleb", kind: "sporting", photo: "https://images.unsplash.com/photo-1558788353-f76d92427f16?w=300&h=300&fit=crop", preview: "Thirteen years of looking up at me with those eyes.",
    story: "Cocker spaniels have those eyes. You know the ones. Beau used those eyes on me every single day for thirteen years and I gave him whatever he wanted every single time. I would do it all again. I would do it forever." }
];

document.getElementById('story-count').textContent = stories.length;

// =====================================================
// FORCE-DIRECTED WEB
// =====================================================
const svg = d3.select('#web-canvas');
const g = svg.append('g');
let width = window.innerWidth;
let height = window.innerHeight;

svg.attr('viewBox', `0 0 ${width} ${height}`);

const centerNode = { id: 'center', isCenter: true, fx: width / 2, fy: height / 2 };
const nodes = [centerNode, ...stories.map((s, i) => ({
  id: s.id,
  story: s,
  ringDistance: 160 + (i * 12)
}))];
const links = stories.map(s => ({ source: 'center', target: s.id }));

nodes.forEach((n, i) => {
  if (n.isCenter) return;
  const angle = (i / (nodes.length - 1)) * Math.PI * 2 + (Math.random() * 0.4 - 0.2);
  n.x = width / 2 + Math.cos(angle) * n.ringDistance;
  n.y = height / 2 + Math.sin(angle) * n.ringDistance;
});

const simulation = d3.forceSimulation(nodes)
  .force('link', d3.forceLink(links).id(d => d.id).distance(d => 150 + Math.random() * 80).strength(0.05))
  .force('charge', d3.forceManyBody().strength(-320))
  .force('collide', d3.forceCollide().radius(58))
  .force('center', d3.forceCenter(width / 2, height / 2).strength(0.04))
  .alphaDecay(0.005);

// Constellation layer (drawn under nodes)
const constellationLayer = g.append('g').attr('class', 'constellation');

// Links
const linkSel = g.append('g').selectAll('line')
  .data(links)
  .enter().append('line')
  .attr('class', 'link')
  .style('opacity', 0);

// Node groups
const nodeSel = g.append('g').selectAll('g')
  .data(nodes)
  .enter().append('g')
  .attr('class', d => d.isCenter ? 'center-book' : 'node-group')
  .style('opacity', 0)
  .on('click', (event, d) => {
    if (!d.isCenter && d.story) {
      openStoryModal(d.story);
      playBell();
    }
  });

// CENTER BOOK NODE — uses the actual cover image
const centerSel = nodeSel.filter(d => d.isCenter);

// Drop shadow underneath
centerSel.append('ellipse')
  .attr('class', 'book-shadow')
  .attr('cx', 4).attr('cy', 100)
  .attr('rx', 60).attr('ry', 12)
  .style('filter', 'blur(8px)');

// The book itself
centerSel.append('image')
  .attr('href', COVER_DATA_URI)
  .attr('x', -65).attr('y', -100)
  .attr('width', 130).attr('height', 195)
  .attr('preserveAspectRatio', 'xMidYMid slice')
  .style('filter', 'drop-shadow(0 8px 18px rgba(42,42,42,0.32))');

// Subtle paper edge highlight
centerSel.append('rect')
  .attr('x', -65).attr('y', -100)
  .attr('width', 130).attr('height', 195)
  .attr('fill', 'none')
  .attr('stroke', 'rgba(42,42,42,0.18)')
  .attr('stroke-width', 1);

// STORY NODES
const storySel = nodeSel.filter(d => !d.isCenter);

const defs = svg.append('defs');
storySel.each(function(d) {
  defs.append('clipPath')
    .attr('id', `clip-${d.id}`)
    .append('circle')
    .attr('r', 36);
});

storySel.append('circle')
  .attr('class', 'node-photo-bg')
  .attr('r', 38);

storySel.append('image')
  .attr('class', 'node-photo')
  .attr('href', d => d.story.photo)
  .attr('x', -36).attr('y', -36)
  .attr('width', 72).attr('height', 72)
  .attr('preserveAspectRatio', 'xMidYMid slice')
  .attr('clip-path', d => `url(#clip-${d.id})`)
  .on('error', function(event, d) {
    const parent = d3.select(this.parentNode);
    d3.select(this).remove();
    parent.append('circle')
      .attr('r', 36)
      .attr('fill', `hsl(${(d.id * 47) % 360}, 45%, 60%)`)
      .attr('clip-path', `url(#clip-${d.id})`);
    parent.append('text')
      .attr('text-anchor', 'middle')
      .attr('dy', 8)
      .style('font-family', "'Caveat Brush', cursive")
      .style('font-size', '24px')
      .style('fill', '#fbf3d8')
      .text(d.story.dogName[0]);
  });

storySel.append('text')
  .attr('class', 'node-label')
  .attr('y', -52)
  .text(d => d.story.dogName);

// =====================================================
// CONSTELLATION HOVER
// =====================================================
storySel
  .on('mouseenter', function(event, d) {
    const kindred = nodes.filter(n => !n.isCenter && n.story.kind === d.story.kind && n.id !== d.id);
    constellationLayer.selectAll('line').remove();
    kindred.forEach(other => {
      constellationLayer.append('line')
        .attr('class', 'constellation-line')
        .attr('x1', d.x).attr('y1', d.y)
        .attr('x2', other.x).attr('y2', other.y)
        .style('opacity', 0)
        .transition().duration(280)
        .style('opacity', 0.75);
    });
  })
  .on('mouseleave', function() {
    constellationLayer.selectAll('line')
      .transition().duration(200)
      .style('opacity', 0)
      .remove();
  });

// =====================================================
// CONTINUOUS RENDER LOOP — physics + breathing
// =====================================================
let breathT = 0;
// Start the simulation but disable D3's built-in tick rendering;
// our requestAnimationFrame loop below handles all rendering.
simulation.on('tick', () => {});

// =====================================================
// LOADING SEQUENCE
// =====================================================
function runEntranceAnimation() {
  // 1. Center book scales in first
  const initialScale = centerSel.select('image');
  centerSel.style('opacity', 0)
    .transition()
    .delay(150)
    .duration(700)
    .ease(d3.easeBackOut.overshoot(1.3))
    .style('opacity', 1);

  centerSel.select('image')
    .attr('transform', 'scale(0.3)')
    .transition()
    .delay(150)
    .duration(700)
    .ease(d3.easeBackOut.overshoot(1.3))
    .attr('transform', 'scale(1)');

  // 2. Stories spiral out one by one
  storySel.each(function(d, i) {
    const node = d3.select(this);
    const photoBg = node.select('.node-photo-bg');
    const photo = node.select('.node-photo');

    // Start collapsed
    photoBg.attr('r', 0);
    photo.style('opacity', 0);

    node.transition()
      .delay(800 + i * 70)
      .duration(50)
      .style('opacity', 1);

    photoBg.transition()
      .delay(800 + i * 70)
      .duration(550)
      .ease(d3.easeBackOut.overshoot(1.4))
      .attr('r', 38);

    photo.transition()
      .delay(800 + i * 70 + 100)
      .duration(400)
      .style('opacity', 1);

    // Subtle arrival glow
    setTimeout(() => {
      const ring = node.append('circle')
        .attr('class', 'arrival-glow')
        .attr('r', 38)
        .style('opacity', 0.9);
      ring.transition()
        .duration(900)
        .ease(d3.easeQuadOut)
        .attr('r', 60)
        .style('opacity', 0)
        .remove();
    }, 800 + i * 70 + 200);
  });

  // 3. Links fade in last
  linkSel
    .transition()
    .delay(1200)
    .duration(900)
    .style('opacity', 1);

  // 4. Reveal toolbar / hint / counter
  setTimeout(() => {
    document.getElementById('toolbar').classList.add('ready');
    document.getElementById('stat-bar').classList.add('ready');
    document.getElementById('hint').classList.add('ready');
    document.getElementById('sound-toggle').classList.add('ready');
  }, 400);
}

// =====================================================
// ZOOM / PAN
// =====================================================
const zoom = d3.zoom()
  .scaleExtent([0.4, 3])
  .on('zoom', (event) => {
    g.attr('transform', event.transform);
  });
svg.call(zoom);

window.addEventListener('resize', () => {
  width = window.innerWidth;
  height = window.innerHeight;
  svg.attr('viewBox', `0 0 ${width} ${height}`);
  centerNode.fx = width / 2; centerNode.fy = height / 2;
  simulation.force('center', d3.forceCenter(width / 2, height / 2).strength(0.04));
  simulation.alpha(0.3).restart();
});

// =====================================================
// SEARCH
// =====================================================
document.getElementById('search-input').addEventListener('input', (e) => {
  const q = e.target.value.trim().toLowerCase();
  storySel.style('opacity', d => {
    if (!q) return 1;
    const match = d.story.dogName.toLowerCase().includes(q) ||
                  d.story.story.toLowerCase().includes(q);
    return match ? 1 : 0.15;
  });
  document.querySelectorAll('.story-card').forEach(card => {
    const name = card.dataset.name.toLowerCase();
    const story = card.dataset.story.toLowerCase();
    card.style.display = (!q || name.includes(q) || story.includes(q)) ? 'flex' : 'none';
  });
});

// =====================================================
// VIEW TOGGLE
// =====================================================
document.querySelectorAll('.view-toggle button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.view-toggle button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const view = btn.dataset.view;
    if (view === 'web') {
      document.getElementById('web-canvas').style.display = '';
      document.getElementById('timeline-view').classList.remove('show');
      document.getElementById('hint').style.display = '';
    } else {
      document.getElementById('web-canvas').style.display = 'none';
      document.getElementById('timeline-view').classList.add('show');
      document.getElementById('hint').style.display = 'none';
    }
  });
});

// =====================================================
// TIMELINE
// =====================================================
const timelineList = document.getElementById('timeline-list');
stories.forEach(s => {
  const card = document.createElement('div');
  card.className = 'story-card';
  card.dataset.name = s.dogName;
  card.dataset.story = s.story;
  card.innerHTML = `
    <img class="story-card-photo" src="${s.photo}" alt="${s.dogName}" onerror="this.style.background='hsl(${(s.id*47)%360},45%,60%)';this.removeAttribute('src');">
    <div class="story-card-content">
      <div class="story-card-name">${s.dogName}</div>
      <div class="story-card-meta">${s.years} · loved by ${s.submitter}</div>
      <div class="story-card-preview">${s.preview}</div>
    </div>
  `;
  card.addEventListener('click', () => { openStoryModal(s); playBell(); });
  timelineList.appendChild(card);
});

// =====================================================
// STORY MODAL
// =====================================================
function openStoryModal(s) {
  document.getElementById('modal-photo').src = s.photo;
  document.getElementById('modal-name').textContent = s.dogName;
  document.getElementById('modal-years').textContent = s.years;
  document.getElementById('modal-submitter').textContent = `Loved by ${s.submitter}`;
  document.getElementById('modal-story').textContent = s.story.replace(/\\n/g, '\n');
  document.getElementById('story-modal').classList.add('show');
}
document.getElementById('story-modal-close').addEventListener('click', () => {
  document.getElementById('story-modal').classList.remove('show');
});
document.getElementById('story-modal').addEventListener('click', (e) => {
  if (e.target.id === 'story-modal') document.getElementById('story-modal').classList.remove('show');
});

// =====================================================
// SUBMIT MODAL
// =====================================================
document.getElementById('share-btn').addEventListener('click', () => {
  document.getElementById('submit-modal').classList.add('show');
});
document.getElementById('submit-modal-close').addEventListener('click', () => {
  document.getElementById('submit-modal').classList.remove('show');
});
document.getElementById('submit-modal').addEventListener('click', (e) => {
  if (e.target.id === 'submit-modal') document.getElementById('submit-modal').classList.remove('show');
});

// Icon style picker
let selectedIconStyle = 'photo';
document.querySelectorAll('.icon-option').forEach(opt => {
  opt.addEventListener('click', () => {
    document.querySelectorAll('.icon-option').forEach(o => o.classList.remove('selected'));
    opt.classList.add('selected');
    selectedIconStyle = opt.dataset.style;
  });
});

// Update icon previews to use the entered name's first letter
document.getElementById('form-dogname').addEventListener('input', (e) => {
  const letter = (e.target.value.trim()[0] || 'O').toUpperCase();
  document.querySelectorAll('.icon-option-preview').forEach(p => {
    if (!p.classList.contains('photo') && !p.classList.contains('both')) {
      p.textContent = letter;
    }
  });
  // Update the "both" overlay letter
  const bothPreviews = document.querySelectorAll('.icon-option-preview.both');
  bothPreviews.forEach(p => {
    p.style.setProperty('--overlay-letter', `'${letter}'`);
  });
});

// =====================================================
// DEMO: simulate a new submission with arrival animation
// =====================================================
document.getElementById('demo-submit').addEventListener('click', () => {
  const nameInput = document.getElementById('form-dogname');
  const dogName = nameInput.value.trim() || 'New Friend';
  const newId = 1000 + Math.floor(Math.random() * 100000);
  const kinds = ['retriever', 'hound', 'working', 'spitz', 'toy', 'bully', 'shepherd', 'sporting', 'terrier'];
  const kind = kinds[Math.floor(Math.random() * kinds.length)];

  // Pick a random fallback color avatar (since no real photo uploaded)
  const newStory = {
    id: newId,
    dogName,
    years: '— ',
    submitter: 'You',
    kind,
    photo: '',
    preview: 'A new story just shared.',
    story: 'Thank you for sharing. (In production, this would save your story and send you a verification email.)'
  };

  // Add to data
  stories.push(newStory);
  document.getElementById('story-count').textContent = stories.length;

  // Add new node positioned at center
  const newNode = { id: newId, story: newStory, x: width / 2, y: height / 2 };
  nodes.push(newNode);
  links.push({ source: 'center', target: newId });

  // Rebuild simulation links + nodes
  simulation.nodes(nodes);
  simulation.force('link').links(links);
  simulation.alpha(0.6).restart();

  // Add the visual node
  const newGroup = g.select('g:last-of-type').append('g')
    .datum(newNode)
    .attr('class', 'node-group')
    .style('opacity', 0)
    .on('click', () => { openStoryModal(newStory); playBell(); });

  defs.append('clipPath')
    .attr('id', `clip-${newId}`)
    .append('circle')
    .attr('r', 36);

  newGroup.append('circle')
    .attr('class', 'node-photo-bg')
    .attr('r', 0);

  // Use color avatar with first letter for new submissions
  const initial = dogName[0].toUpperCase();
  const hue = (newId * 47) % 360;
  newGroup.append('circle')
    .attr('r', 36)
    .attr('fill', `hsl(${hue}, 45%, 60%)`)
    .attr('clip-path', `url(#clip-${newId})`)
    .style('opacity', 0);
  newGroup.append('text')
    .attr('text-anchor', 'middle')
    .attr('dy', 8)
    .style('font-family', "'Caveat Brush', cursive")
    .style('font-size', '24px')
    .style('fill', '#fbf3d8')
    .style('opacity', 0)
    .text(initial);
  newGroup.append('text')
    .attr('class', 'node-label')
    .attr('y', -52)
    .text(dogName);

  // Add the new link
  g.select('g').selectAll('line')
    .data(links)
    .enter().append('line')
    .attr('class', 'link')
    .style('opacity', 0)
    .transition()
    .delay(800)
    .duration(700)
    .style('opacity', 1);

  // Update node selection refs
  // (The new node will animate via the spawn sequence below)

  // Close form
  document.getElementById('submit-modal').classList.remove('show');

  // Spawn animation: scale up + golden glow
  newGroup.transition().duration(80).style('opacity', 1);
  newGroup.select('.node-photo-bg')
    .transition()
    .duration(700)
    .ease(d3.easeBackOut.overshoot(1.6))
    .attr('r', 38);
  newGroup.selectAll('circle:not(.node-photo-bg), text')
    .transition()
    .delay(200)
    .duration(500)
    .style('opacity', 1);

  // Big golden flash
  for (let i = 0; i < 3; i++) {
    const ring = newGroup.append('circle')
      .attr('class', 'arrival-glow')
      .attr('r', 38)
      .style('opacity', 1)
      .style('stroke-width', 2.5);
    ring.transition()
      .delay(i * 200)
      .duration(1400)
      .ease(d3.easeQuadOut)
      .attr('r', 80)
      .style('opacity', 0)
      .remove();
  }

  // Bell sound
  playBell();
  setTimeout(() => playBell(660), 200);

  // Re-grab nodeSel and storySel references so render loop animates the new one
  rebuildSelections();

  // Smooth-ish camera nudge to follow the new node into view
  const transform = d3.zoomTransform(svg.node());
  svg.transition().duration(800).call(
    zoom.transform,
    transform // keep current view, the spiral animation does the talking
  );
});

// Helper to refresh d3 selections after dynamic node addition
let storySelRef = storySel;
let nodeSelRef = nodeSel;
function rebuildSelections() {
  // Get all current node groups
  storySelRef = g.selectAll('.node-group');
  nodeSelRef = g.selectAll('.node-group, .center-book');

  // Re-attach hover listeners for new nodes
  storySelRef.on('mouseenter', function(event, d) {
    if (!d || d.isCenter || !d.story) return;
    const kindred = nodes.filter(n => !n.isCenter && n.story && n.story.kind === d.story.kind && n.id !== d.id);
    constellationLayer.selectAll('line').remove();
    kindred.forEach(other => {
      constellationLayer.append('line')
        .attr('class', 'constellation-line')
        .attr('x1', d.x).attr('y1', d.y)
        .attr('x2', other.x).attr('y2', other.y)
        .style('opacity', 0)
        .transition().duration(280)
        .style('opacity', 0.75);
    });
  })
  .on('mouseleave', function() {
    constellationLayer.selectAll('line')
      .transition().duration(200)
      .style('opacity', 0)
      .remove();
  });
}

// Updated render loop to use refreshed selections
function renderUpdate() {
  breathT += 0.006;

  g.selectAll('line.link')
    .attr('x1', d => d.source.x)
    .attr('y1', d => d.source.y)
    .attr('x2', d => d.target.x)
    .attr('y2', d => d.target.y);

  g.selectAll('.node-group, .center-book').attr('transform', d => {
    if (!d) return '';
    if (d.isCenter) return `translate(${d.x},${d.y})`;
    const phase = (d.id || 0) * 0.71;
    const dx = Math.sin(breathT + phase) * 3;
    const dy = Math.cos(breathT + phase * 1.3) * 2.4;
    return `translate(${d.x + dx},${d.y + dy})`;
  });

  requestAnimationFrame(renderUpdate);
}
// Replace the original render loop
renderUpdate();

// =====================================================
// SOUND
// =====================================================
let audioCtx = null;
let ambientGain = null;
let soundOn = false;

function startAudio() {
  if (audioCtx) return;
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  ambientGain = audioCtx.createGain();
  ambientGain.gain.value = 0;
  ambientGain.connect(audioCtx.destination);

  // Soft ambient pad — A2 root, 5th, octave, 11th
  const baseFreq = 110;
  const intervals = [1, 1.5, 2, 2.667];
  intervals.forEach((mult) => {
    const osc = audioCtx.createOscillator();
    const oscGain = audioCtx.createGain();
    const filter = audioCtx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 1200;
    filter.Q.value = 0.8;

    osc.type = 'sine';
    osc.frequency.value = baseFreq * mult;
    oscGain.gain.value = 0.16 / intervals.length;

    // Slow LFO for detune
    const lfo = audioCtx.createOscillator();
    const lfoGain = audioCtx.createGain();
    lfo.frequency.value = 0.06 + Math.random() * 0.05;
    lfoGain.gain.value = 0.6 + Math.random() * 0.4;
    lfo.connect(lfoGain);
    lfoGain.connect(osc.detune);

    osc.connect(filter);
    filter.connect(oscGain);
    oscGain.connect(ambientGain);
    osc.start();
    lfo.start();
  });

  // Fade in
  ambientGain.gain.linearRampToValueAtTime(0.06, audioCtx.currentTime + 5);
}

function stopAudio() {
  if (!audioCtx) return;
  ambientGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 1);
}

function playBell(freq) {
  if (!soundOn || !audioCtx) return;
  const now = audioCtx.currentTime;
  const f = freq || 880;
  // Two stacked sine tones for a warmer bell
  [f, f * 1.5, f * 2].forEach((freqVal, i) => {
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freqVal;
    const peak = i === 0 ? 0.18 : (i === 1 ? 0.06 : 0.03);
    gainNode.gain.setValueAtTime(0, now);
    gainNode.gain.linearRampToValueAtTime(peak, now + 0.01);
    gainNode.gain.exponentialRampToValueAtTime(0.001, now + 1.6);
    osc.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 1.7);
  });
}

document.getElementById('sound-toggle').addEventListener('click', () => {
  soundOn = !soundOn;
  const btn = document.getElementById('sound-toggle');
  const label = document.getElementById('sound-label');
  const icon = document.getElementById('sound-icon');
  if (soundOn) {
    startAudio();
    btn.classList.add('on');
    label.textContent = 'sound on';
    icon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>';
  } else {
    stopAudio();
    btn.classList.remove('on');
    label.textContent = 'turn on sound';
    icon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/>';
  }
});

// =====================================================
// KICK IT OFF
// =====================================================
runEntranceAnimation();

</script>
</body>
