{% comment %}
  Renders a simplified embedded Giftnote form inside the product form.

  Accepts:
  - product: {Object} product object
  - section: {Object} section to which this snippet belongs
  - block: {Object} block to which this snippet belongs
{% endcomment %}

<script
  src="{{ 'giftnote-embedded-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign storage_mode = 'cart-attributes'
  assign default_method = 'tracked'

  if product.gift_card?
    assign storage_mode = 'line-item-properties'
    assign default_method = 'instant'
  endif
%}

<giftnote-embedded-form
  class="giftnote-embed"
  data-storage-mode="{{ storage_mode }}"
  data-default-method="{{ default_method }}"
  data-default-from="{{ shop.name | escape }}"
>
  <fieldset
    class="giftnote-embed__toggle"
    aria-label="Purchase type"
  >
    <legend class="visually-hidden">Purchase type</legend>

    <label class="giftnote-embed__toggle-option">
      <input
        type="radio"
        name="giftnote-toggle-{{ block.id }}"
        value="self"
        checked
        data-ref="mode"
      >
      <span>For Myself</span>
    </label>

    <label class="giftnote-embed__toggle-option">
      <input
        type="radio"
        name="giftnote-toggle-{{ block.id }}"
        value="gift"
        data-ref="mode"
      >
      <span class="giftnote-embed__toggle-label">
        <span
          class="giftnote-embed__toggle-icon"
          aria-hidden="true"
        >
          {{- 'heart.svg' | inline_asset_content -}}
        </span>
        <span>Gift a Copy</span>
      </span>
    </label>
  </fieldset>

  <div
    class="giftnote-embed__panel"
    data-ref="panel"
    hidden
  >
    <div class="giftnote-embed__header">
      <h3 class="giftnote-embed__title">Send comfort to someone navigating the loss of their beloved companion.</h3>
    </div>

    <div class="field">
      <label
        class="visually-hidden"
        for="Giftnote-to-{{ block.id }}"
      >
        Recipient's name
      </label>
      <input
        id="Giftnote-to-{{ block.id }}"
        class="input giftnote-embed__input"
        type="text"
        placeholder="Recipient's name"
        maxlength="100"
        autocomplete="name"
        data-ref="to"
      >
    </div>

    <div class="field">
      <label
        class="visually-hidden"
        for="Giftnote-email-{{ block.id }}"
      >
        Recipient's email
      </label>
      <input
        id="Giftnote-email-{{ block.id }}"
        class="input giftnote-embed__input"
        type="email"
        placeholder="Recipient's email"
        inputmode="email"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        data-ref="email"
      >
    </div>

    <div class="field giftnote-embed__message-field">
      <label
        class="visually-hidden"
        for="Giftnote-message-{{ block.id }}"
      >
        Personal message
      </label>
      <textarea
        id="Giftnote-message-{{ block.id }}"
        class="input textarea giftnote-embed__input giftnote-embed__textarea"
        rows="5"
        maxlength="210"
        placeholder="Personal message (optional)"
        data-ref="message"
      ></textarea>
      <span
        class="giftnote-embed__character-count"
        data-ref="messageCount"
      >
        0/210
      </span>
    </div>

    <p class="giftnote-embed__note">
      <span class="giftnote-embed__note-icon" aria-hidden="true">✧</span>
      <span>We'll send a beautiful email letting them know about your thoughtful gift.</span>
    </p>

    <div
      class="giftnote-embed__status"
      data-ref="status"
      hidden
    ></div>
  </div>

  {% if storage_mode == 'line-item-properties' %}
    <input type="hidden" name="properties[giftnote_to]" data-hidden-field="giftnote_to" disabled>
    <input type="hidden" name="properties[giftnote_from]" data-hidden-field="giftnote_from" disabled>
    <input type="hidden" name="properties[giftnote_message]" data-hidden-field="giftnote_message" disabled>
    <input type="hidden" name="properties[giftnote_medium]" data-hidden-field="giftnote_medium" disabled>
    <input type="hidden" name="properties[giftnote_email]" data-hidden-field="giftnote_email" disabled>
    <input type="hidden" name="properties[giftnote_phone]" data-hidden-field="giftnote_phone" disabled>
    <input type="hidden" name="properties[giftnote_method]" data-hidden-field="giftnote_method" disabled>
    <input type="hidden" name="properties[giftnote_time]" data-hidden-field="giftnote_time" disabled>
  {% endif %}
</giftnote-embedded-form>

{% stylesheet %}
  .giftnote-embed {
    width: 100%;
    margin-block-end: var(--gap);
  }

  .giftnote-embed__toggle {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, #f8f1e7 0%, #f3ebdf 100%);
    box-shadow: inset 0 0 0 1px rgb(232 223 211 / 0.9);
  }

  .giftnote-embed__toggle-option {
    position: relative;
    display: flex;
  }

  .giftnote-embed__toggle-option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .giftnote-embed__toggle-option span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 4rem;
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    color: #65727d;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    font-weight: 600;
    line-height: 1;
    text-align: center;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing),
      box-shadow var(--animation-speed) var(--animation-easing),
      transform var(--animation-speed) var(--animation-easing);
  }

  .giftnote-embed__toggle-option:has(input:checked) span {
    background: #fff;
    color: #333c44;
    box-shadow:
      inset 0 0 0 2px rgb(122 127 132 / 0.75),
      0 10px 24px rgb(218 204 188 / 0.26);
  }

  .giftnote-embed__toggle-option:has(input:focus-visible) span {
    outline: 2px solid #b6becb;
    outline-offset: 2px;
  }

  .giftnote-embed__toggle-label {
    display: inline-flex;
  }

  .giftnote-embed__toggle-icon {
    display: inline-flex;
    width: 1.35rem;
    height: 1.35rem;
  }

  .giftnote-embed__toggle-icon svg {
    width: 100%;
    height: 100%;
  }

  .giftnote-embed__panel {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 2vw, 2.2rem);
    border-radius: 2rem;
    background:
      radial-gradient(circle at top center, rgb(255 255 255 / 0.7), transparent 60%),
      linear-gradient(180deg, #f8f4ed 0%, #f6f1ea 100%);
    box-shadow: inset 0 0 0 1px rgb(226 218 206 / 0.55);
  }

  .giftnote-embed__panel[hidden] {
    display: none !important;
  }

  .giftnote-embed__header {
    display: grid;
    gap: 0.5rem;
  }

  .giftnote-embed__title {
    margin: 0;
    max-width: 19ch;
    color: #67727c;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 1.14;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .giftnote-embed__message-field {
    position: relative;
  }

  .giftnote-embed__input {
    border: 2px solid #dfe5ee;
    border-radius: 1.7rem;
    background: #fff;
    color: #6a7380;
    box-shadow: 0 10px 24px rgb(220 210 196 / 0.16);
  }

  .giftnote-embed__input::placeholder {
    color: #a5adba;
    opacity: 1;
  }

  .giftnote-embed__input:focus-visible {
    border-color: #cad3de;
    outline: none;
    box-shadow: 0 0 0 3px rgb(223 229 238 / 0.65);
  }

  .giftnote-embed__input.input,
  .giftnote-embed__input.textarea {
    padding: 1.5rem 1.8rem;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.35;
  }

  .giftnote-embed__textarea {
    min-height: 10rem;
    resize: vertical;
    padding-bottom: 2.6rem;
  }

  .giftnote-embed__character-count {
    position: absolute;
    right: 1.5rem;
    bottom: 1rem;
    color: #b2b8c2;
    font-size: 0.9rem;
    line-height: 1;
    pointer-events: none;
  }

  .giftnote-embed__note {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin: 0;
    color: #67727c;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.35;
    font-weight: 500;
  }

  .giftnote-embed__note-icon {
    color: #f0ca54;
    font-size: 1.5rem;
    line-height: 1;
    transform: translateY(-0.05em);
  }

  .giftnote-embed__status {
    margin: 0;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    color: rgb(var(--color-error-rgb));
    background: rgb(var(--color-error-rgb) / 0.08);
    font-size: var(--font-size--sm);
  }

  @media screen and (max-width: 749px) {
    .giftnote-embed__toggle {
      margin-bottom: 1rem;
      padding: 0.28rem;
      gap: 0.28rem;
    }

    .giftnote-embed__toggle-option span {
      min-height: 3.4rem;
      padding: 0.75rem 0.85rem;
      gap: 0.55rem;
      font-size: 1rem;
    }

    .giftnote-embed__toggle-icon {
      width: 1.15rem;
      height: 1.15rem;
    }

    .giftnote-embed__panel {
      gap: 1.1rem;
      padding: 1.25rem;
      border-radius: 1.5rem;
    }

    .giftnote-embed__title {
      max-width: none;
      font-size: 1.9rem;
    }

    .giftnote-embed__input.input,
    .giftnote-embed__input.textarea {
      padding: 1.15rem 1.25rem;
      border-radius: 1.35rem;
    }

    .giftnote-embed__textarea {
      min-height: 8.5rem;
      padding-bottom: 2.4rem;
    }

    .giftnote-embed__character-count {
      right: 1.1rem;
      bottom: 0.9rem;
    }
  }
{% endstylesheet %}
