{% comment %}
  Renders a basic embedded Giftnote form inside the product form.

  Accepts:
  - product: {Object} product object
  - section: {Object} section to which this snippet belongs
  - block: {Object} block to which this snippet belongs
{% endcomment %}

<script
  src="{{ 'giftnote-embedded-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign storage_mode = 'cart-attributes'

  if product.gift_card?
    assign storage_mode = 'line-item-properties'
  endif
%}

<giftnote-embedded-form
  class="giftnote-embed"
  data-storage-mode="{{ storage_mode }}"
  data-default-from="{{ shop.name | escape }}"
>
  <div class="giftnote-embed__header">
    <p class="giftnote-embed__subtitle">
      Send comfort to someone navigating the loss of their beloved companion.
    </p>
  </div>

  <div class="field">
    <label class="visually-hidden" for="Giftnote-to-{{ block.id }}">Recipient's name</label>
    <input
      id="Giftnote-to-{{ block.id }}"
      class="input giftnote-embed__input"
      type="text"
      placeholder="Recipient's name"
      maxlength="100"
      autocomplete="name"
      data-ref="to"
    >
  </div>

  <div class="field">
    <label class="visually-hidden" for="Giftnote-email-{{ block.id }}">Recipient's email</label>
    <input
      id="Giftnote-email-{{ block.id }}"
      class="input giftnote-embed__input"
      type="email"
      placeholder="Recipient's email"
      inputmode="email"
      autocomplete="email"
      autocorrect="off"
      autocapitalize="off"
      data-ref="email"
    >
  </div>

  <div class="field giftnote-embed__message-field">
    <label class="visually-hidden" for="Giftnote-message-{{ block.id }}">Personal message</label>
    <textarea
      id="Giftnote-message-{{ block.id }}"
      class="input textarea giftnote-embed__input giftnote-embed__textarea"
      rows="5"
      maxlength="210"
      placeholder="Personal message (optional)"
      data-ref="message"
    ></textarea>
  </div>

  <p class="giftnote-embed__note">
    <span class="giftnote-embed__note-icon" aria-hidden="true">✧</span>
    <span>We'll send a beautiful email letting them know about your thoughtful gift.</span>
  </p>

  <button class="giftnote-embed__save" type="button" data-ref="saveButton">Save message</button>

  <div class="giftnote-embed__status" data-ref="status" hidden></div>

  {% if storage_mode == 'line-item-properties' %}
    <input type="hidden" name="properties[giftnote_to]" data-hidden-field="giftnote_to">
    <input type="hidden" name="properties[giftnote_from]" data-hidden-field="giftnote_from">
    <input type="hidden" name="properties[giftnote_message]" data-hidden-field="giftnote_message">
    <input type="hidden" name="properties[giftnote_medium]" data-hidden-field="giftnote_medium">
    <input type="hidden" name="properties[giftnote_email]" data-hidden-field="giftnote_email">
    <input type="hidden" name="properties[giftnote_phone]" data-hidden-field="giftnote_phone">
    <input type="hidden" name="properties[giftnote_method]" data-hidden-field="giftnote_method">
    <input type="hidden" name="properties[giftnote_time]" data-hidden-field="giftnote_time">
  {% endif %}
</giftnote-embedded-form>

{% stylesheet %}
  .giftnote-embed {
    display: grid;
    gap: 0.95rem;
    width: 100%;
    padding: 1.55rem 1.45rem 1.3rem;
    margin-block-end: calc(var(--gap) * 2);
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at top center, rgb(255 255 255 / 0.72), transparent 62%),
      linear-gradient(180deg, #f8f4ed 0%, #f5f0e8 100%);
    box-shadow: inset 0 0 0 1px rgb(230 222 210 / 0.75);
  }

  .giftnote-embed__header {
    display: block;
  }

  .giftnote-embed__subtitle {
    margin: 0;
    max-width: 28rem;
    font-size: 1.04rem;
    line-height: 1.36;
    font-weight: 500;
    color: #687480;
  }

  .giftnote-embed__input {
    display: block;
    width: 100%;
    border: 1px solid #d9dfe8;
    border-radius: 1rem;
    background: #fff;
    box-sizing: border-box;
    box-shadow: 0 2px 6px rgb(220 213 202 / 0.12);
  }

  .giftnote-embed__input.input,
  .giftnote-embed__input.textarea {
    padding: 0.92rem 1rem;
    font-size: 1rem;
    line-height: 1.35;
    color: #63707c;
  }

  .giftnote-embed__input::placeholder {
    color: #9aa4b4;
    opacity: 1;
  }

  .giftnote-embed__textarea {
    min-height: 7.75rem;
    resize: vertical;
    padding-bottom: 1rem;
  }

  .giftnote-embed__message-field {
    position: relative;
  }

  .giftnote-embed__note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    color: #67727c;
    font-size: 0.96rem;
    line-height: 1.35;
    font-weight: 500;
  }

  .giftnote-embed__note-icon {
    color: #f0ca54;
    font-size: 1.12rem;
    line-height: 1;
    transform: translateY(0.05rem);
  }

  .giftnote-embed__save {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.9rem 1rem;
    border: 0;
    border-radius: 0.5rem;
    background: #4f81ee;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
  }

  .giftnote-embed__status {
    padding: 0.85rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .giftnote-embed__status[data-status='success'] {
    color: #215f39;
    background: rgb(33 95 57 / 0.08);
  }

  .giftnote-embed__status[data-status='error'] {
    color: rgb(var(--color-error-rgb));
    background: rgb(var(--color-error-rgb) / 0.08);
  }

  @media screen and (max-width: 749px) {
    .giftnote-embed {
      gap: 0.8rem;
      padding: 1.15rem 1rem 1rem;
      border-radius: 1rem;
    }

    .giftnote-embed__subtitle {
      font-size: 0.94rem;
      line-height: 1.32;
    }

    .giftnote-embed__input.input,
    .giftnote-embed__input.textarea {
      padding: 0.85rem 0.9rem;
      font-size: 0.96rem;
    }

    .giftnote-embed__textarea {
      min-height: 6.75rem;
    }

    .giftnote-embed__note {
      font-size: 0.88rem;
    }
  }
{% endstylesheet %}
