<div class="subscribe-container">
  <div class="header-icon-container">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#E8C547" stroke="currentColor" stroke-width="0" stroke-linecap="round" stroke-linejoin="round" class="header-icon">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
    </svg>
  </div>
  <h2 class="subscribe-header">Join Our Community</h2>
  <p class="subscribe-body">A gentle space for dog lovers navigating loss. Receive comforting words, healing resources, and reminders that you're not alone.</p>
  {% comment %} <form class="subscribe-form">
    <div class="email-input-container">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9BA8C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="subscribe-mail-icon">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <input type="email" class="subscribe-email-input" placeholder="Your email address" required="" value="">
    </div>
    <button class="subscribe-submit-btn" type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send mr-2">
          <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
          <path d="m21.854 2.147-10.94 10.939"></path>
        </svg>
        Subscribe
    </button>
  </form> {% endcomment %}


  {%- form 'customer', class: 'subscribe-form' %}
    <div class="input-button-container">
      <div
        class="email-input-container"
        style="--border-width: {{ block_settings.border_width }}px; --border-radius: {{ block_settings.border_radius }}px;"
      >
        <label
          for="EmailInput-{{ block.id }}"
          class="visually-hidden"
        >
          {{ 'blocks.email_signup.label' | t }}
        </label>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9BA8C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="subscribe-mail-icon">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <input
          id="EmailInput-{{ block.id }}"
          class="subscribe-email-input"
          type="email"
          name="contact[email]"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
          required
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Email-signup__message-error-{{ block.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Email-signup__message-success-{{ block.id }}"
          {% endif %}
        >
      </div>
      <button class="subscribe-submit-btn" type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send mr-2">
          <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
          <path d="m21.854 2.147-10.94 10.939"></path>
        </svg>
        Subscribe
      </button>
    </div>
    {%- if form.errors -%}
      <div
        id="Email-signup__message-error"
        class="email-signup__message email-signup__message--error"
        tabindex="-1"
      >
        <svg
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
          focusable="false"
          aria-hidden="true"
          class="icon-error"
        >
          {%- render 'icon', icon: 'error'  -%}
        </svg>
        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        id="Email-signup__message-success"
        class="email-signup__message email-signup__message--success"
        tabindex="-1"
      >
        <span class="svg-wrapper icon-success">
          {{ 'icon-checkmark.svg' | inline_asset_content }}
        </span>
        <p class="email-signup__message-text">{{ 'blocks.email_signup.success' | t }}</p>
      </div>
    {%- endif -%}
  {% endform %}


  <p class="subscribe-sub-text">We respect your inbox. Only meaningful content, never spam.</p>
</div>
<style>
  .subscribe-container{
    background: linear-gradient(135deg, #F5ECE4 0%, #FFFFFF 100%);
    max-width: 700px;
    margin: auto;
    border-radius: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.02);
    padding: 48px;
  }
  .header-icon-container{
    display: inline-block;
    padding: 16px;
    background: #F6E9CE;
    border-radius: 9999px;
    margin-bottom:24px;
  }
  .subscribe-header{
    margin-top:0;
    font-weight: 500;
    font-size: 30px;
    margin-bottom:16px;
  }
  .subscribe-body{
    max-width: 448px;
    margin: auto;
    font-size: 16px;
    font-weight: 500;
    margin-bottom:32px;
  }
  .input-button-container{
    display: inline-flex;
    gap: 12px;
  }
  .email-input-container{
    display: inline-flex;
    justify-content: center;
    flex-direction: column;
    position: relative;
  }
  .subscribe-mail-icon{
    position: absolute;
    left: 20px;
  }
  .subscribe-email-input{
    border: 1px solid #DEDFE5;
    background: transparent;
    padding: 12px 0 12px 50px;
    border-radius: 999px;
    font-size:14px;
    width:272px;
  }
  .subscribe-submit-btn{
    display: inline-flex;
    padding: 15px;
    border-radius: 999px;
    border: none;
    background: var(--dgg-blue);
    color: white;
    font-size: 14px;
    gap: 16px;
    font-weight: 600;
    width: 164px;
    justify-content: center;
    cursor:pointer;
    transition: all 0.3s ease;
  }
  .subscribe-submit-btn:hover{
    background: var(--dgg-dark-blue);
  }
  .subscribe-sub-text{
    margin-top: 24px;
    font-size: 12px;
    color: #636e7299;
  }
  #Email-signup__message-success{
    margin-top: 16px;
    justify-content: center;
  }
  @media screen and (max-width:1023px){
    .subscribe-form{
      max-width: 100%;
    }
    .input-button-container{
      display: flex;
      flex-direction:column;
      width: 100%;
      max-width: 100%;
    }
    .email-input-container{
      width: 100%;
      max-width: 100%;
    }
    .subscribe-email-input{
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
    .subscribe-submit-btn{
      width: 100%;
      max-width: 100%;
    }
  }
  @media screen and (max-width:480px){
    .subscribe-header{
      font-size:24px;
    }
  }
</style>
