8f3","center_content":false,"background_gradient":"linear-gradient(135deg, #9FAECC 0%, #E8C547 100%)","gap_desktop":24,"gap_mobile":16,"pt_desktop":80,"prl_desktop":24,"pb_desktop":80,"pt_mobile":64,"prl_mobile":16,"pb_mobile":64,"additional_css":".pdp-quote-container {\n  padding: 48px;\n  max-width: 832px;\n  margin: auto;\n  background: linear-gradient(135deg, #f5eee4 0%, #fff 100%);\n  box-shadow: 12px 12px 24px rgba(0, 0, 0, 0.12);\n  border-radius: 24px;\n}\n.pdp-quote-container .pdp-quote-text {\n  font-family: \"Playfair Display\";\n  color: var(--dgg-black);\n  margin-left: 0;\n  margin-right: 0;\n  font-size: 24px;\n  line-height: 32px;\n  font-weight: 500;\n}\n.pdp-quote-container .quote-signature-container {\n  gap:16px !important;\n  flex-direction:row !important;\n}\n.pdp-quote-container .quote-signature-icon-container {\n  align-items: center !important;\n  background: #E6E6E7;\n  height:48px;\n  width:48px;\n  border-radius:999px;\n}\n.pdp-quote-container .quote-signature-name {\n  margin-bottom: 0;\n  font-family: \"Playfair Display\";\n  color:var(--dgg-black);\n  font-size:16px;\n  font-weight:500;\n}\n.pdp-quote-container .quote-signature-title {\n  margin-top: 0;\n  font-weight:500;\n}","column_1_align_desktop":"top","column_1_html":"<div class=\"pdp-quote-container\" style=\"opacity: 1; transform: none\">\n  <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"40\" height=\"40\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--dgg-yellow)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote text-[#E8C547] mb-6\">\n    <path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"><\/path>\n    <path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"><\/path>\n  <\/svg>\n  <blockquote class=\"pdp-quote-text\">\n    \"The Dog Grief Guide was created to help you navigate the heartbreak of losing your beloved dog. Inside, you'll find\n    comforting words, gentle journaling prompts, and space to pour your heart out. It's part book, part companion—here\n    to walk beside you as the world keeps moving while your heart stands still.\"\n  <\/blockquote>\n  <div class=\"flex quote-signature-container\">\n    <div class=\"flex items-center justify-center quote-signature-icon-container\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"20\" height=\"20\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--dgg-blue)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart text-[#9BA8C4] quote-signature-icon\">\n        <path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"><\/path>\n      <\/svg>\n    <\/div>\n    <div>\n      <p class=\"quote-signature-name\">Nate Aframian<\/p>\n      <p class=\"quote-signature-title\">Founder, The Dog Grief Guide<\/p>\n    <\/div>\n  <\/div>\n<\/div>","column_1_image_first":"image_first","column_1_img_pt":0,"column_1_img_prl":0,"column_1_img_pb":0,"show_column_2":false,"column_2_align_desktop":"top","column_2_html":"<h2>Column 2<\/h2>\n<p>Add HTML here.<\/p>","column_2_image_first":"image_first","column_2_img_pt":0,"column_2_img_prl":0,"column_2_img_pb":0,"show_column_3":false,"column_3_align_desktop":"top","column_3_html":"<h2>Column 3<\/h2>\n<p>Add HTML here.<\/p>","column_3_image_first":"image_first","column_3_img_pt":0,"column_3_img_prl":0,"column_3_img_pb":0}},"custom_section_LJnJQ4":{"type":"custom-section","custom_css":[".column-image img {max-width: 448px; margin: auto; border-radius: 16px; box-shadow: 6px 12px 24px rgba(0, 0, 0, 0.1);}",".content-container {gap: 80px;}","h2 {font-size: 36px; color: var(--dgg-black);}","p {font-size: 16px; font-weight: 500;}",".explore-the-guide-link {display: flex; gap: 8px; font-size: 16px; margin-top: 36px; font-weight: 500; color: var(--dgg-blue);}",".explore-the-guide-arrow {\/* margin-left: 8px; *\/}","@media screen and (max-width: 1023px) {.content-container {flex-direction: column-reverse; gap: 48px; }}"],"name":"Custom Section","settings":{"content_key":"why-this-matters","bg_type":"solid","background_color":"#fdf8f3","center_content":false,"background_gradient":"linear-gradient(135deg, #9FAECC 0%, #E8C547 100%)","gap_desktop":24,"gap_mobile":16,"pt_desktop":80,"prl_desktop":24,"pb_desktop":80,"pt_mobile":64,"prl_mobile":16,"pb_mobile":80,"additional_css":"","column_1_align_desktop":"top","column_1_html":"","column_1_image":"shopify:\/\/shop_images\/74a215d25_Screenshot2025-12-23at115907AM.jpg","column_1_image_first":"image_first","column_1_img_pt":0,"column_1_img_prl":0,"column_1_img_pb":0,"show_column_2":true,"column_2_align_desktop":"center","column_2_html":"<div class=\"why-this-matters-container\" style=\"opacity: 1; transform: none\">\n  <h2>Why This Matters<\/h2>\n  <div class=\"space-y-4 font-sans text-[#636E72] leading-relaxed\">\n    <p>\n      Losing a dog is not \"just losing a pet.\" It's losing a family member, a daily companion, a source of unconditional\n      love that may be unlike any other in your life.\n    <\/p>\n    <p>\n      The pain runs as deep as any love story we'll ever have. And that pain deserves to be honored, understood, and\n      gently held.\n    <\/p>\n    <p>\n      This guide exists because your grief matters. Because your love was real. Because the bond you shared will never\n      truly end—it simply changes form.\n    <\/p>\n  <\/div>\n  <div>\n    <a class=\"explore-the-guide-link\" href=\"\/products\/the-dog-grief-guide\"><span>Explore the Guide<\/span><span class=\"explore-the-guide-arrow\">→<\/span><\/a>\n  <\/div>\n<\/div>","column_2_image_first":"image_first","column_2_img_pt":0,"column_2_img_prl":0,"column_2_img_pb":0,"show_column_3":false,"column_3_align_desktop":"top","column_3_html":"<h2>Column 3<\/h2>\n<p>Add HTML here.<\/p>","column_3_image_first":"image_first","column_3_img_pt":0,"column_3_img_prl":0,"column_3_img_pb":0}}},"order":["main","page_header_tCtWUX","custom_section_i8mykB","custom_section_7T3nkd","custom_section_rxUXQW","custom_section_LJnJQ4"]}