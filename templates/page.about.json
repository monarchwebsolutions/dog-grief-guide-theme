{"sections":{"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":40,"padding-block-end":80}},"page_header_tCtWUX":{"type":"page-header","name":"Page Header","settings":{"pill_icon":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"16\" height=\"16\" viewbox=\"0 0 24 24\" fill=\"#E8C547\" stroke=\"currentColor\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart text-[#E8C547]\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"><\/path><\/svg>","pill_text":"Our Story","header_text":"About Nate & Oxmo","subheader_text":"A story of love, loss, and the unbreakable bond between a man and his golden retriever."}},"custom_section_i8mykB":{"type":"custom-section","custom_css":["h2 {font-size: 36px;}","p {font-weight: 500; font-size: 16px;}",".emphasized-text {font-weight: 600; color: var(--dgg-blue);}",".column-image img {max-width: 448px; margin: auto; border-radius: 16px; box-shadow: 12px 12px 24px rgba(0, 0, 0, 0.15);}",".content-container {gap: 80px;}","@media screen and (max-width: 1023px) {.content-container {gap: 48px; }}","@media screen and (max-width: 749px) {h2 {font-size: 30px; } .img-text {font-size: 14px; max-width: 90%; }}"],"name":"Custom Section","settings":{"content_key":"the-heart-behind-the-guide","bg_type":"solid","background_color":"#fdf8f3","center_content":false,"background_gradient":"linear-gradient(135deg, #9FAECC 0%, #E8C547 100%)","gap_desktop":24,"gap_mobile":16,"pt_desktop":80,"prl_desktop":24,"pb_desktop":80,"pt_mobile":64,"prl_mobile":16,"pb_mobile":64,"additional_css":".img-text {\n  position: absolute;\n  bottom: 50px;\n  text-align: center;\n  width: 100%;\n  background-color: rgba(256, 256, 256, 0.9);\n  font-size: 14px;\n  padding: 12px;\n  border-radius: 12px;\n  max-width: 480px;\n  margin: auto;\n  right: 0;\n  left: 0;\n}","column_1_align_desktop":"center","column_1_html":"<h2>The Heart Behind the Guide<\/h2><p>Nate Aframian is the founder of GoodForDogs.com and, more importantly, the human who was loved by Oxmo—a golden retriever whose spirit was as bright as the California sun.<\/p><p>When Oxmo passed, Nate found himself navigating a grief so profound that it surprised even him. As someone who had always understood the depth of the human-animal bond, he still wasn't prepared for how losing Oxmo would shake him to his core.<\/p><p>In those dark days, Nate searched for something—anything—that could help. A book that understood. A companion that didn't try to rush the grief or minimize the loss. He couldn't find it.<\/p>\n<p class=\"emphasized-text\">So he created it.<\/p>","column_1_image_first":"image_first","column_1_img_pt":0,"column_1_img_prl":0,"column_1_img_pb":0,"show_column_2":true,"column_2_align_desktop":"top","column_2_html":"<p class=\"img-text\">Nate & Oxmo, the beginning of an unbreakable bond<\/p>","column_2_image":"shopify:\/\/shop_images\/1445982c6_IMG_5057_Original.jpg","column_2_image_first":"image_first","column_2_img_pt":0,"column_2_img_prl":0,"column_2_img_pb":0,"show_column_3":false,"column_3_align_desktop":"top","column_3_html":"<h2>Column 3<\/h2>\n<p>Add HTML here.<\/p>","column_3_image_first":"image_first","column_3_img_pt":0,"column_3_img_prl":0,"c