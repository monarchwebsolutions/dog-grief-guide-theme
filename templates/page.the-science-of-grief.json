on","settings":{"content_key":"","bg_type":"solid","background_color":"#fef9f2","center_content":false,"background_gradient":"linear-gradient(135deg, #9FAECC 0%, #E8C547 100%)","gap_desktop":24,"gap_mobile":16,"pt_desktop":0,"prl_desktop":24,"pb_desktop":64,"pt_mobile":24,"prl_mobile":16,"pb_mobile":64,"additional_css":".what-this-means-box {\n  margin-bottom: 32px;\n  background: linear-gradient(135deg, #f5eee4 0%, #fff 100%);\n  box-shadow: 12px 12px 24px rgba(0, 0, 0, 0.12);\n  border-radius: 16px;\n  padding: 24px;\n  max-width: 400px;\n}\n.what-this-means-col-1-container {\n  display: flex;\n  justify-content: flex-end;\n}\n.what-this-means-col-2-container {\n  display: flex;\n  justify-content: flex-start;\n}","column_1_align_desktop":"top","column_1_html":"<div class=\"what-this-means-col-1-container\">\n<div class=\"what-this-means-col what-this-means-col-1\">\n  <div class=\"what-this-means-box\">\n    <h3>Give Yourself Permission<\/h3>\n    <p>You have every right to grieve deeply. Don't let anyone minimize what you're feeling.<\/p>\n  <\/div>\n  <div class=\"what-this-means-box\">\n    <h3>Seek Support<\/h3>\n    <p>Find people who understand. Pet loss support groups and understanding friends can help.<\/p>\n  <\/div>\n<\/div>\n<\/div>","column_1_image_first":"image_first","column_1_img_pt":0,"column_1_img_prl":0,"column_1_img_pb":0,"show_column_2":true,"column_2_align_desktop":"top","column_2_html":"<div class=\"what-this-means-col-2-container\">\n<div class=\"what-this-means-col what-this-means-col-2\">\n  <div class=\"what-this-means-box\">\n    <h3>Take Your Time<\/h3>\n    <p>There's no timeline for healing. Honor your grief at whatever pace feels right for you.<\/p>\n  <\/div>\n  <div class=\"what-this-means-box\">\n    <h3>Honor the Bond<\/h3>\n    <p>Create rituals, keep memories alive, and know that your love continues to matter.<\/p>\n  <\/div>\n<\/div>\n<\/div>","column_2_image_first":"image_first","column_2_img_pt":0,"column_2_img_prl":0,"colu