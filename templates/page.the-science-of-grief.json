_img_pb":0,"show_column_3":false,"column_3_align_desktop":"top","column_3_html":"<h2>Column 3<\/h2>\n<p>Add HTML here.<\/p>","column_3_image_first":"image_first","column_3_img_pt":0,"column_3_img_prl":0,"column_3_img_pb":0}},"custom_section_7T3nkd":{"type":"custom-section","custom_css":[".large-star {margin: auto;}","h2 {color: white; font-size: 36px; margin: 24px 0; font-weight: 500;}","p {font-size: 20px; color: white; max-width: 672px; margin: auto; font-weight: 500; margin-top: 16px;}","p span {display: block; color: var(--dgg-yellow); margin-top: 16px; font-weight: 600;}",".book-icon {color: var(--dgg-yellow); margin: auto;}","@media screen and (max-width: 749px) {h2 {font-size: 30px; }}"],"name":"Custom Section","settings":{"content_key":"","bg_type":"solid","background_color":"#9ba8c4","center_content":true,"background_gradient":"linear-gradient(135deg, #9FAECC 0%, #E8C547 100%)","gap_desktop":24,"gap_mobile":16,"pt_desktop":80,"prl_desktop":24,"pb_desktop":80,"pt_mobile":64,"prl_mobile":16,"pb_mobile":64,"additional_css":"","column_1_align_desktop":"top","column_1_html":"<div class=\"key-insight-container\">\n  <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"32\" height=\"32\" viewbox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"book-icon\">\n    <path d=\"M12 7v14\"><\/path>\n    <path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"><\/path>\n  <\/svg>\n  <h2>A Key Insight<\/h2>\n  <p>Research has shown that dog owners often experience grief that is comparable in intensity to the loss of a close human relationship.<span>You are not overreacting. You are responding to a real loss.<\/span><\/p>\n<\/div>","column_1_image_first":"image_first","column_1_img_pt":0,"column_1_img_prl":0,"column_1_img_pb":0,"show_column_2":false,"column_2_align_desktop":"top","column_2_html":"<h2>Column 2<